# .env.dev.example — DEV persona. Pairs with docker-compose.dev.yml
# (the fast-iteration file: Dockerfile.dev for both services, Vite
# dev server, Playwright-compatible).
#
# Usage:
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up --build
#
# Compose does NOT auto-load `.env.dev`; the `--env-file` flag is
# required. Keeping the file distinct from `.env` lets contributors
# switch between the prod and dev compose files without losing their
# per-file overrides.
#
# Every key below is consumed by either frontend/src, signaling/, or
# the compose file itself — audited via
#   rg -n "import\.meta\.env\.|os\.Getenv\(" frontend/src signaling/
#
# No real secrets belong in this file; it is committed to the repo.
# Placeholder strings are DEV-ONLY and MUST be rotated before any
# non-localhost use (NFR-002 / NFR-005).

# ---------------------------------------------------------------------
# Host ports (docker-compose port publish)
# ---------------------------------------------------------------------
FRONTEND_PORT=5173
SIGNALING_PORT=8080

# ---------------------------------------------------------------------
# Frontend — signaling URL override
# ---------------------------------------------------------------------
# Read by frontend/src/components/{JoinForm,FailurePanel}.tsx. The
# dev image re-reads env on container restart (unlike the prod image,
# which bakes `VITE_*` values during `npm run build`).
VITE_SIGNALING_URL=wss://localhost:5173/ws

# ---------------------------------------------------------------------
# ICE servers — STUN / TURN (surfaced via `ready_for_offer`)
# ---------------------------------------------------------------------
VITE_STUN_URLS=stun:stun.l.google.com:19302

# TURN is OPTIONAL and OFF by default. See .env.example for the full
# opt-in recipe; the same four variables + TURN_USERNAME /
# TURN_PASSWORD apply here.
# VITE_TURN_URL=turn:localhost:3478
# VITE_TURN_USERNAME=webrtc
# VITE_TURN_CREDENTIAL=replace-me-dev-only

# ---------------------------------------------------------------------
# Signaling server — logging (NFR-003)
# ---------------------------------------------------------------------
# Dev persona: text format is easier to skim while iterating; debug
# level surfaces heartbeat + room-lifecycle traces. Prod persona uses
# json / info — see .env.example.
LOG_FORMAT=text
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# Signaling server — WebSocket heartbeat (contract §3.16)
# ---------------------------------------------------------------------
# Contract defaults. Do NOT widen without re-validating SC-009
# (≤ 10 s ungraceful-disconnect detection).
PING_INTERVAL_MS=5000
PONG_TIMEOUT_MS=5000

# ---------------------------------------------------------------------
# coturn container credentials (opt-in)
# ---------------------------------------------------------------------
# Uncomment alongside VITE_TURN_* above if you enable the `coturn`
# block in docker-compose.yml. Values MUST match
# VITE_TURN_USERNAME / VITE_TURN_CREDENTIAL.
# TURN_USERNAME=webrtc
# TURN_PASSWORD=replace-me-dev-only
