# .env.dev.example — DEV persona. Pairs with docker-compose.dev.yml
# (the fast-iteration file: Dockerfile.dev for both services, Vite
# dev server, Playwright-compatible).
#
# Usage — pick one:
#
# Method A (recommended when you switch between prod + dev compose):
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up --build
#   # Compose does NOT auto-load `.env.dev`; the `--env-file` flag is
#   # required. Keeping the file distinct from `.env` lets contributors
#   # switch between the prod and dev compose files without losing their
#   # per-file overrides.
#
# Method B (simpler when you only ever use the dev compose):
#   cp .env.dev.example .env
#   docker compose -f docker-compose.dev.yml up --build
#   # Compose auto-loads `.env` from the project root, so no `--env-file`
#   # flag is needed. Tradeoff: a later `docker compose up` (prod compose)
#   # picks up these dev defaults too — harmless functionally (LOG_FORMAT
#   # text instead of json), but be aware before you go cross-stream.
#
# Every key below is consumed by either frontend/src, signaling/, or
# the compose file itself — audited via
#   rg -n "import\.meta\.env\.|os\.Getenv\(" frontend/src signaling/
#
# Naming convention:
#   - VITE_* keys are read by the FRONTEND bundle (import.meta.env).
#   - All other keys are read by the SIGNALING SERVER (config.Load
#     in signaling/internal/shared/config/app.go) or by compose itself.
#
# No real secrets belong in this file; it is committed to the repo.
# Placeholder strings are DEV-ONLY and MUST be rotated before any
# non-localhost use (NFR-002 / NFR-005).

# ---------------------------------------------------------------------
# Host ports (docker-compose port publish)
# ---------------------------------------------------------------------
FRONTEND_PORT=5173
SIGNALING_PORT=8080

# ---------------------------------------------------------------------
# Signaling server — validation/security profile
# ---------------------------------------------------------------------
# Dev profile: WS_ALLOWED_ORIGINS may be empty (the default below).
# When empty, the server accepts WebSocket upgrades from any origin
# (InsecureSkipVerify=true) so the Vite dev server on a different
# port can connect freely. Set WS_ALLOWED_ORIGINS to lock down
# origins even in dev. The prod persona (.env.example) requires it
# to be non-empty.
APP_ENV=dev
# WS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------
# Frontend — signaling URL override (OPTIONAL)
# ---------------------------------------------------------------------
# Read by frontend/src/components/{JoinForm,FailurePanel}.tsx. Since
# T103 the default fallback is same-origin —
# `${wss:|ws:}//${window.location.host}/ws` — and Vite dev's
# `server.proxy` (frontend/vite.config.ts) forwards `/ws` →
# signaling:8080. Localhost and LAN-IP access both work unmodified:
# open the page at the URL you want the WS to go to, and the
# fallback derives the matching origin. Override only when signaling
# lives on a different origin from the frontend.
#
# The dev image re-reads env on container restart (unlike the prod
# image, which bakes `VITE_*` at `npm run build`; see .env.example
# for the prod override recipe).
# VITE_SIGNALING_URL=wss://192.168.1.42:5173/ws

# Mesh-mode signaling URL override. Read by
# frontend/src/modes/mesh/route/MeshApp.tsx. Same default-fallback
# shape as VITE_SIGNALING_URL with `/ws/mesh` instead of `/ws`.
# VITE_MESH_SIGNALING_URL=wss://192.168.1.42:5173/ws/mesh

# ---------------------------------------------------------------------
# ICE servers — STUN / TURN (relayed via signaling payloads)
# ---------------------------------------------------------------------
# Read by the SIGNALING SERVER. The server relays them to clients;
# the frontend never reads these directly. See .env.example for the
# rationale behind the bare ICE_ prefix.
ICE_STUN_URLS=stun:stun.l.google.com:19302

# TURN is OPTIONAL and OFF by default. See .env.example for the full
# opt-in recipe; the same four variables + TURN_USERNAME /
# TURN_PASSWORD apply here.
# ICE_TURN_URL=turn:localhost:3478
# ICE_TURN_USERNAME=webrtc
# ICE_TURN_CREDENTIAL=replace-me-dev-only

# ---------------------------------------------------------------------
# Signaling server — logging (NFR-003)
# ---------------------------------------------------------------------
# Dev persona: text format is easier to skim while iterating; debug
# level surfaces heartbeat + room-lifecycle traces. Prod persona uses
# json / info — see .env.example.
LOG_FORMAT=text
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# Signaling server — WebSocket heartbeat (contract §3.16)
# ---------------------------------------------------------------------
# Contract defaults. Do NOT widen without re-validating SC-009
# (≤ 10 s ungraceful-disconnect detection). Both values must be
# positive integers; config.Load fails fast on anything else.
PING_INTERVAL_MS=5000
PONG_TIMEOUT_MS=5000

# ---------------------------------------------------------------------
# coturn container credentials (opt-in)
# ---------------------------------------------------------------------
# Uncomment alongside ICE_TURN_* above if you enable the `coturn`
# block in docker-compose.yml. Values MUST match
# ICE_TURN_USERNAME / ICE_TURN_CREDENTIAL.
# TURN_USERNAME=webrtc
# TURN_PASSWORD=replace-me-dev-only
