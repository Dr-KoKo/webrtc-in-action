# Phase 0 dev image — minimal, non-production. Phase 13 (T083) will
# replace this with a multi-stage production image.
#
# Node 22 is the current stable LTS (supported through April 2027).
# Node 20 reaches EOL on 2026-04-30, so we track one LTS line ahead.
FROM node:22-alpine

WORKDIR /app

# Install dependencies deterministically from the lockfile. `npm ci`
# refuses to run if package.json and package-lock.json disagree — the
# right discipline for build images. Developers who intentionally
# change deps commit the updated lockfile first.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
