# .env.example — PROD persona. Pairs with docker-compose.yml
# (the default file: distroless signaling + vite preview frontend).
#
# Usage:
#   cp .env.example .env
#   docker compose up --build
#
# Compose auto-loads `.env` from the project root. Every key below
# is consumed by either frontend/src, signaling/, or the compose
# file itself — audited via
#   rg -n "import\.meta\.env\.|os\.Getenv\(" frontend/src signaling/
# See docker-compose.yml for where each one is wired.
#
# No real secrets belong in this file; it is committed to the repo.
# Placeholder strings are DEV-ONLY and MUST be rotated before any
# non-localhost use (NFR-002 / NFR-005).

# ---------------------------------------------------------------------
# Host ports (docker-compose port publish)
# ---------------------------------------------------------------------
FRONTEND_PORT=5173
SIGNALING_PORT=8080

# ---------------------------------------------------------------------
# Frontend — signaling URL override
# ---------------------------------------------------------------------
# Read by frontend/src/components/{JoinForm,FailurePanel}.tsx. If
# unset at build time, the client derives the WS URL from
# `window.location` so the default localhost flow works unmodified.
# Only override for LAN testing. NOTE: Vite bakes `VITE_*` values
# into the JS bundle at `npm run build` (prod image) — changing this
# after the prod image is built requires a rebuild. The dev image
# (`vite dev` via docker-compose.dev.yml) re-reads env on container
# restart.
VITE_SIGNALING_URL=wss://localhost:5173/ws

# ---------------------------------------------------------------------
# ICE servers — STUN / TURN (surfaced via `ready_for_offer`)
# ---------------------------------------------------------------------
# Comma-separated STUN URL list. Public Google STUN is fine for
# localhost learning.
VITE_STUN_URLS=stun:stun.l.google.com:19302

# TURN is OPTIONAL and OFF by default. To learn the TURN-relay path
# (spec FR-012, quickstart §6):
#   1. Uncomment the four variables below (client + server creds).
#   2. Uncomment the `coturn` block in docker-compose.yml.
#   3. Uncomment TURN_USERNAME / TURN_PASSWORD further down so the
#      coturn container uses matching credentials.
#   4. `docker compose up --build`.
# TURN credentials are long-lived shared secrets in MVP — do NOT
# commit real values. Any placeholder you uncomment is DEV-ONLY and
# MUST be rotated.
# VITE_TURN_URL=turn:localhost:3478
# VITE_TURN_USERNAME=webrtc
# VITE_TURN_CREDENTIAL=replace-me-dev-only

# ---------------------------------------------------------------------
# Signaling server — logging (NFR-003)
# ---------------------------------------------------------------------
# Prod persona: structured JSON for log aggregators; info level keeps
# noise low. For the dev persona's `LOG_FORMAT=text` / `LOG_LEVEL=debug`
# see .env.dev.example.
LOG_FORMAT=json
LOG_LEVEL=info

# ---------------------------------------------------------------------
# Signaling server — WebSocket heartbeat (contract §3.16)
# ---------------------------------------------------------------------
# Worst-case ungraceful-disconnect detection =
# PING_INTERVAL_MS + PONG_TIMEOUT_MS. Defaults 5000 + 5000 = ≤ 10 s
# (satisfies SC-009). Do not widen without re-validating SC-009.
PING_INTERVAL_MS=5000
PONG_TIMEOUT_MS=5000

# ---------------------------------------------------------------------
# coturn container credentials (opt-in; required only when the
# `coturn` block in docker-compose.yml is uncommented)
# ---------------------------------------------------------------------
# These feed coturn's `--user=${TURN_USERNAME}:${TURN_PASSWORD}` CLI
# flag. They MUST match VITE_TURN_USERNAME / VITE_TURN_CREDENTIAL
# above — the browser-side client and the coturn server have to
# agree on credentials. Placeholder below is DEV-ONLY; rotate before
# any non-localhost use.
# TURN_USERNAME=webrtc
# TURN_PASSWORD=replace-me-dev-only
