# .env.example — PROD persona. Pairs with docker-compose.yml
# (the default file: distroless signaling + vite preview frontend).
#
# Usage:
#   cp .env.example .env
#   docker compose up --build
#
# Compose auto-loads `.env` from the project root. Every key below
# is consumed by either frontend/src, signaling/, or the compose
# file itself — audited via
#   rg -n "import\.meta\.env\.|os\.Getenv\(" frontend/src signaling/
# See docker-compose.yml for where each one is wired.
#
# Naming convention:
#   - VITE_* keys are read by the FRONTEND bundle (import.meta.env).
#   - All other keys are read by the SIGNALING SERVER (config.Load
#     in signaling/internal/shared/config/app.go) or by compose itself.
#
# No real secrets belong in this file; it is committed to the repo.
# Placeholder strings are DEV-ONLY and MUST be rotated before any
# non-localhost use (NFR-002 / NFR-005).

# ---------------------------------------------------------------------
# Host ports (docker-compose port publish)
# ---------------------------------------------------------------------
FRONTEND_PORT=5173
SIGNALING_PORT=8080

# ---------------------------------------------------------------------
# Signaling server — validation/security profile
# ---------------------------------------------------------------------
# APP_ENV is a NARROW switch that only tightens config validation:
#   - dev  : WS_ALLOWED_ORIGINS may be empty; Accept then runs with
#            InsecureSkipVerify=true (any origin allowed).
#   - prod : WS_ALLOWED_ORIGINS MUST be non-empty; otherwise
#            config.Load() returns an error and the process exits.
# APP_ENV does NOT itself choose origin lists or any security
# behavior — WS_ALLOWED_ORIGINS does. Keep that boundary explicit.
APP_ENV=prod

# ---------------------------------------------------------------------
# Signaling server — WebSocket Accept origin allowlist
# ---------------------------------------------------------------------
# Comma-separated list of origin patterns the server accepts on the
# /ws and /ws/mesh endpoints. Built into
# coder/websocket.AcceptOptions.OriginPatterns at startup.
# Same-origin is always implicitly allowed; this list governs
# CROSS-origin upgrades only.
#
# Default below matches `vite preview`'s self-signed HTTPS bind at
# https://localhost:5173/ — sufficient for the quickstart flow.
# Set explicitly for any non-localhost deploy.
WS_ALLOWED_ORIGINS=https://localhost:5173

# ---------------------------------------------------------------------
# Frontend — signaling URL override (OPTIONAL; default same-origin)
# ---------------------------------------------------------------------
# Since T103, frontend/src/components/{JoinForm,FailurePanel}.tsx'
# resolveSignalingUrl() falls back to
#   `${wss:|ws:}//${window.location.host}/ws`
# — i.e., the same origin as the page. vite preview's preview.proxy
# in frontend/vite.config.ts forwards that `/ws` upgrade to
# signaling:8080 inside the compose network, with TLS terminating on
# the frontend container's :5173 listener. That covers localhost,
# LAN IP, and any single-origin deployment without further config.
#
# You only need to override when signaling lives on a DIFFERENT
# origin (e.g., a cloud deploy that terminates TLS in front of
# signaling directly and bypasses the frontend proxy).
#
# PROD-IMAGE CAVEAT: `vite preview` serves the pre-built dist/ from
# Stage 1 of frontend/Dockerfile. `VITE_*` values are baked at
# `npm run build` (Stage 1), but frontend/Dockerfile does NOT
# currently declare `ARG VITE_SIGNALING_URL`, so setting this
# variable in `.env` is a no-op against the default prod image. To
# actually override in prod, also patch frontend/Dockerfile Stage 1
# to `ARG VITE_SIGNALING_URL` + `ENV VITE_SIGNALING_URL=$VITE_SIGNALING_URL`,
# add `build.args.VITE_SIGNALING_URL: ${VITE_SIGNALING_URL}` to the
# frontend service in docker-compose.yml, and run
# `docker compose up --build`. The dev image (vite dev via
# docker-compose.dev.yml) re-reads env on container restart, so no
# Dockerfile change is needed there — see .env.dev.example.
# VITE_SIGNALING_URL=wss://192.168.1.42:5173/ws

# Mesh-mode signaling URL override. Read by
# frontend/src/modes/mesh/route/MeshApp.tsx.
# Same default fallback shape as VITE_SIGNALING_URL above, with
# `/ws/mesh` instead of `/ws`. Same prod-image caveat applies.
# VITE_MESH_SIGNALING_URL=wss://192.168.1.42:5173/ws/mesh

# ---------------------------------------------------------------------
# ICE servers — STUN / TURN (relayed via signaling payloads)
# ---------------------------------------------------------------------
# These are read by the SIGNALING SERVER (not the frontend); the
# server relays them to clients in `ready_for_offer` /
# `join_accepted` / pair instructions. The bare names (no VITE_
# prefix) reflect that — VITE_ would imply the frontend bundle
# reads them directly, which it does not.
#
# Comma-separated STUN URL list. Public Google STUN is fine for
# localhost learning.
ICE_STUN_URLS=stun:stun.l.google.com:19302

# TURN is OPTIONAL and OFF by default. To learn the TURN-relay path
# (spec FR-012, quickstart §6):
#   1. Uncomment the four variables below (client + server creds).
#   2. Uncomment the `coturn` block in docker-compose.yml.
#   3. Uncomment TURN_USERNAME / TURN_PASSWORD further down so the
#      coturn container uses matching credentials.
#   4. `docker compose up --build`.
# TURN credentials are long-lived shared secrets in MVP — do NOT
# commit real values. Any placeholder you uncomment is DEV-ONLY and
# MUST be rotated.
# ICE_TURN_URL=turn:localhost:3478
# ICE_TURN_USERNAME=webrtc
# ICE_TURN_CREDENTIAL=replace-me-dev-only

# ---------------------------------------------------------------------
# Signaling server — logging (NFR-003)
# ---------------------------------------------------------------------
# Prod persona: structured JSON for log aggregators; info level keeps
# noise low. For the dev persona's `LOG_FORMAT=text` / `LOG_LEVEL=debug`
# see .env.dev.example.
LOG_FORMAT=json
LOG_LEVEL=info

# ---------------------------------------------------------------------
# Signaling server — WebSocket heartbeat (contract §3.16)
# ---------------------------------------------------------------------
# Worst-case ungraceful-disconnect detection =
# PING_INTERVAL_MS + PONG_TIMEOUT_MS. Defaults 5000 + 5000 = ≤ 10 s
# (satisfies SC-009). Do not widen without re-validating SC-009.
# Both values must be positive integers; config.Load fails fast on
# anything else.
PING_INTERVAL_MS=5000
PONG_TIMEOUT_MS=5000

# ---------------------------------------------------------------------
# coturn container credentials (opt-in; required only when the
# `coturn` block in docker-compose.yml is uncommented)
# ---------------------------------------------------------------------
# These feed coturn's `--user=${TURN_USERNAME}:${TURN_PASSWORD}` CLI
# flag. They MUST match ICE_TURN_USERNAME / ICE_TURN_CREDENTIAL
# above — the browser-side client and the coturn server have to
# agree on credentials. Placeholder below is DEV-ONLY; rotate before
# any non-localhost use.
# TURN_USERNAME=webrtc
# TURN_PASSWORD=replace-me-dev-only
