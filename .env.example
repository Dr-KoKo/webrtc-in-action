# .env.example — copy to .env for local development.
# No real secrets belong in this file; it is committed to the repo.
#
# Consumed by:
# - frontend/  (VITE_* variables, read at Vite build time)
# - signaling/ (LOG_FORMAT, LOG_LEVEL, SIGNALING_PORT, PING/PONG timings)
# - docker-compose.yml (service ports)

# ---------------------------------------------------------------------
# Ports (docker-compose + local dev)
# ---------------------------------------------------------------------
FRONTEND_PORT=5173
SIGNALING_PORT=8080

# ---------------------------------------------------------------------
# Frontend — STUN / TURN (Phase 4 / Phase 12 consumer)
# ---------------------------------------------------------------------
# Comma-separated list of STUN URLs. Public Google STUN is fine for
# localhost learning. Quoting is not required; Vite passes the raw
# string through and the client splits on ",".
VITE_STUN_URLS=stun:stun.l.google.com:19302

# TURN is OPTIONAL and OFF by default. Uncomment + fill in the three
# variables below to learn the TURN-relay path (spec FR-012).
# TURN credentials are long-lived shared secrets in the MVP — do NOT
# commit real values.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# ---------------------------------------------------------------------
# Signaling server — logging
# ---------------------------------------------------------------------
# JSON is the default (production-friendly). Set LOG_FORMAT=text for
# local dev readability.
LOG_FORMAT=json
LOG_LEVEL=info

# ---------------------------------------------------------------------
# Signaling server — WebSocket heartbeat (contract §3.16)
# Worst-case ungraceful-disconnect detection = PING_INTERVAL_MS +
# PONG_TIMEOUT_MS. Defaults: 5000 + 5000 = ≤ 10 s (satisfies SC-009).
# ---------------------------------------------------------------------
PING_INTERVAL_MS=5000
PONG_TIMEOUT_MS=5000
